# ============================================================
# EnerSentry - 仓库根 .gitignore
# 依据 ENS-DEV-ARCH 2.2.2 与 ENS-DEV-BOOT 3.1 编制
# 三类不入库：构建产物 / IDE 用户文件 / 运行期生成数据
# ============================================================

# ---------- 1. 构建产物（out-of-source） ----------
build/
out/
bin/

# ---------- 2. IDE / 编辑器 用户文件 ----------
*.user
*.user.*
.vs/
.vscode/
CMakeUserPresets.json

# ---------- 3. 运行期生成数据（绝不入库） ----------
apps/ens_app/data/
apps/device_simulator/data/

# ---------- 4. 杂项 ----------
compile_commands.json
*.log
Thumbs.db
.DS_Store
