{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-debug",
      "displayName": "VS2022 Debug (Qt 5.15.2 + vcpkg)",
      "description": "Ninja + MSVC v143; paths are supplied through the documented environment variables",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vs2022-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{MSVC_CXX_COMPILER}",
        "CMAKE_MAKE_PROGRAM": "$env{NINJA_EXECUTABLE}",
        "ENS_QT_ROOT": "$env{QT_ROOT}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "vs2022-release",
      "displayName": "VS2022 Release (Qt 5.15.2 + vcpkg)",
      "inherits": "vs2022-debug",
      "binaryDir": "${sourceDir}/build/vs2022-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "hidden": true,
      "name": "Qt",
      "cacheVariables": {
        "ENS_QT_ROOT": "$env{QT_ROOT}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "vs2022-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "vendor": {
    "qt-project.org/Presets": {
      "checksum": "3DuC2C/7mlifnRVCqA4Rph/3lOw="
    }
  }
}
